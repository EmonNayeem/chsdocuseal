<%= form_for @template, data: { turbo_frame: :_top }, html: { autocomplete: :off } do |f| %>
  <div class="form-control mt-4">
    <%= f.text_field :name, required: true, placeholder: t('document_name'), class: 'base-input', dir: 'auto' %>
  </div>
  <div class="mt-3 mb-4 flex items-center justify-between">
    <label for="folder_name" class="cursor-pointer">
      <%= svg_icon('folder', class: 'w-6 h-6') %>
    </label>
    <folder-autocomplete class="flex justify-between w-full">
      <set-value data-on="blur" data-value="<%= TemplateFolder::DEFAULT_NAME %>" data-empty-only="true" class="peer w-full whitespace-nowrap">
        <input id="folder_name" placeholder="<%= t('folder_name') %>" type="text" class="w-full outline-none border-transparent focus:border-transparent focus:ring-0 bg-base-100 px-1" name="folder_name" value="<%= params[:folder_name].presence || TemplateFolder::DEFAULT_NAME %>" autocomplete="off">
      </set-value>
      <set-value data-on="click" data-value="" data-input-id="folder_name" class="peer-focus-within:hidden whitespace-nowrap">
        <label for="folder_name" data-clear-on-focus="true" class="shrink-0 link mr-1.5 cursor-pointer">
          <%= t('change_folder') %>
        </label>
      </set-value>
    </folder-autocomplete>
  </div>

  <% available_departments = if current_user.department_acl_admin?
                               current_account.departments.order(:name)
                             else
                               current_user.departments.order(:name)
                             end %>

  <% if available_departments.present? %>
    <div class="mt-4">
      <label class="label">Departments</label>

      <%= hidden_field_tag 'template[department_ids][]', '' %>

      <div class="space-y-2">
        <% available_departments.each do |department| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag 'template[department_ids][]',
                              department.id,
                              !current_user.department_acl_admin?,
                              class: 'checkbox checkbox-sm' %>

            <span><%= department.name %></span>
          </label>
        <% end %>
      </div>

      <% if current_user.department_acl_admin? %>
        <p class="text-sm opacity-70 mt-1">
          Leaving all departments unchecked makes this template admin-only once department access control is enforced.
        </p>
      <% end %>
    </div>
  <% elsif !current_user.department_acl_admin? %>
    <div class="alert alert-warning mt-4">
      Ask an admin to assign you to a department before creating templates.
    </div>
  <% end %>

  <div class="mt-4 mb-4 flex items-center justify-between border border-base-300 rounded-xl px-4 py-3">
    <span>
      Confidential / invite only
      <span class="block text-sm opacity-70">
        Only emails already added as recipients can open the public link.
      </span>
    </span>

    <div class="flex">
      <%= hidden_field_tag 'template[preferences][confidential_access]', 'false' %>
      <%= check_box_tag 'template[preferences][confidential_access]',
                        'true',
                        false,
                        class: 'toggle' %>
    </div>
  </div>

  <div class="form-control">
    <%= f.button button_title(title: t('create'), disabled_with: t('creating')), class: 'base-button' %>
  </div>
<% end %>
