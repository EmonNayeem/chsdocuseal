<%= form_for user, html: { class: 'space-y-4' }, data: { turbo_frame: :_top } do |f| %>
  <div class="space-y-2">
    <div class="flex space-x-4">
      <div class="w-full">
        <%= f.label :first_name, t('first_name'), class: 'label' %>
        <%= f.text_field :first_name, required: true, class: 'base-input w-full', dir: 'auto' %>
      </div>

      <div class="w-full">
        <%= f.label :last_name, t('last_name'), class: 'label' %>
        <%= f.text_field :last_name, required: true, class: 'base-input w-full', dir: 'auto' %>
      </div>
    </div>

    <div class="form-control">
      <%= f.label :email, t('email'), class: 'label' %>
      <%= f.email_field :email, required: true, class: 'base-input' %>

      <% if user.try(:pending_reconfirmation?) %>
        <label class="label">
          <span class="label-text-alt"><%= t('email_address_is_awaiting_confirmation_follow_the_link_in_the_email_to_confirm', email: f.object.unconfirmed_email) %></span>
        </label>
      <% end %>
      <% if user.persisted? && (Docuseal.multitenant? || Accounts.can_send_emails?(current_account)) %>
        <span class="label-text-alt mt-2 mx-1">
          <%= t('click_here_to_send_a_reset_password_email_html') %>
        </span>
      <% end %>
    </div>

    <% if user.new_record? && !Docuseal.multitenant? %>
      <div class="form-control">
        <%= f.label :password, t('password'), class: 'label' %>
        <%= f.password_field :password, class: 'base-input' %>
      </div>
    <% end %>

    <% if f.object != current_user %>
      <% if user.otp_required_for_login %>
        <div class="form-control">
          <%= f.label :otp_required_for_login, t('two_factor_authentication'), class: 'label' %>
          <%= f.select :otp_required_for_login, [[t('enabled'), true], [t('disabled'), false]], { include_blank: false }, class: 'base-select' %>
        </div>
      <% end %>

      <%= render 'role_select', f: f %>

      <% if current_user.platform_admin? && @companies.present? %>
        <div class="form-control">
          <%= f.label :company_id, 'Company', class: 'label' %>
          <%= f.collection_select :company_id, @companies, :id, :name, { include_blank: false }, class: 'base-select' %>
        </div>
      <% end %>
    <% end %>

    <% departments_to_render = current_user.platform_admin? && @all_account_departments ? @all_account_departments : @available_departments %>
    <% if can?(:manage, Department) && departments_to_render.present? %>
      <% admin_role_selected = user.role == User::ADMIN_ROLE %>
      <% target_company_id = user.company_id || current_user.company_id %>

      <user-departments-form>
        <div data-user-departments-wrapper="true" class="<%= 'opacity-50' if admin_role_selected %>">
          <label class="label">Departments</label>

          <p data-admin-departments-message="true"
            class="text-sm opacity-70 mb-2 <%= 'hidden' unless admin_role_selected %>">
            Admin users can access all departments automatically, so department assignment is not required.
          </p>

          <%= hidden_field_tag 'user[department_ids][]', '' %>

          <div class="space-y-2">
            <% target_user = f.object %>
            <% selected_department_ids =
                 if target_user.persisted?
                   UserDepartment.where(user_id: target_user.id).pluck(:department_id).map(&:to_i)
                 else
                   Array(target_user.department_ids).map(&:to_i)
                 end %>
            <% departments_to_render.each do |department| %>
              <% is_hidden = current_user.platform_admin? && department.company_id != target_company_id %>
              <label class="flex items-center gap-2 department-checkbox-label <%= 'hidden' if is_hidden %>" data-company-id="<%= department.company_id %>" data-department-id="<%= department.id %>" data-selected="<%= selected_department_ids.include?(department.id.to_i) %>">
                <%= check_box_tag 'user[department_ids][]',
                                  department.id,
                                  admin_role_selected || selected_department_ids.include?(department.id.to_i),
                                  class: 'checkbox checkbox-sm department-checkbox',
                                  disabled: admin_role_selected,
                                  data: { user_department_checkbox: true } %>

                <span><%= department.name %></span>
              </label>
            <% end %>
            <div id="no-departments-message" class="alert <%= 'hidden' if departments_to_render.any? { |d| d.company_id == target_company_id } %>">
              Create departments first, then assign users to them.
            </div>
          </div>
        </div>
      </user-departments-form>
    <% elsif can?(:manage, Department) %>
      <div class="alert">
        Create departments first, then assign users to them.
      </div>
    <% end %>

    <% if local_assigns[:extra_fields_html].present? %>
      <%= local_assigns[:extra_fields_html] %>
    <% end %>
  </div>

  <div class="form-control pt-2">
    <%= f.button button_title, class: 'base-button' %>
  </div>
<% end %>

<% if user.persisted? %>
  <%= button_to nil, user_send_reset_password_path(user), id: 'resend_password_button', method: :put, class: 'hidden', data: { turbo_confirm: t('are_you_sure_'), turbo_frame: :_top } %>
<% end %>
