<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto">
    <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-center mb-4">
      <h1 class="text-4xl font-bold">Edit Company</h1>
      <%= link_to 'Back to Companies', settings_companies_path, class: 'btn btn-ghost btn-sm' %>
    </div>

    <% if @company.errors.any? %>
      <div class="alert alert-error shadow-lg mb-6">
        <div>
          <ul>
            <% @company.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="alert alert-info shadow-lg mb-6">
      <div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current flex-shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span><strong>Note:</strong> These SMTP settings are saved but are not yet used for sending emails.</span>
      </div>
    </div>

    <%= form_for @company, url: settings_company_path(@company), method: :patch, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :name, 'Name', class: 'label' %>
          <%= f.text_field :name, class: 'base-input', disabled: true %>
        </div>
        <div class="form-control">
          <%= f.label :code, 'Code', class: 'label' %>
          <%= f.text_field :code, class: 'base-input', disabled: true %>
        </div>
      </div>

      <div class="form-control">
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :active, class: 'checkbox checkbox-primary' %>
          <span class="label-text">Active</span>
        </label>
      </div>

      <div class="divider">SMTP Settings</div>

      <div class="form-control mb-4">
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :smtp_enabled, class: 'checkbox checkbox-primary' %>
          <span class="label-text font-semibold">Enable Custom SMTP</span>
        </label>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :smtp_address, 'SMTP Address', class: 'label' %>
          <%= f.text_field :smtp_address, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :smtp_port, 'SMTP Port', class: 'label' %>
          <%= f.text_field :smtp_port, class: 'base-input' %>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :smtp_user_name, 'Username', class: 'label' %>
          <%= f.text_field :smtp_user_name, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :smtp_password, 'Password', class: 'label' %>
          <%= f.password_field :smtp_password, value: '', class: 'base-input', placeholder: @company.smtp_password.present? ? '*************' : '' %>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :smtp_domain, "Domain (#{t('optional')})", class: 'label' %>
          <%= f.text_field :smtp_domain, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :smtp_authentication, 'Authentication', class: 'label' %>
          <%= f.select :smtp_authentication, options_for_select([%w[Plain plain], %w[Login login], %w[CRAM-MD5 cram_md5]], @company.smtp_authentication.presence || 'plain'), { prompt: true }, class: 'base-select' %>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <label class="label cursor-pointer justify-start gap-3 mt-8">
            <%= f.check_box :smtp_enable_starttls_auto, class: 'checkbox checkbox-primary' %>
            <span class="label-text">Enable STARTTLS Auto</span>
          </label>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :smtp_from_email, t('send_from_email'), class: 'label' %>
          <%= f.email_field :smtp_from_email, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :smtp_from_name, 'Send From Name (Optional)', class: 'label' %>
          <%= f.text_field :smtp_from_name, class: 'base-input' %>
        </div>
      </div>

      <div class="divider mt-8">Branding Settings</div>

      <div class="alert alert-info shadow-lg mb-6">
        <div>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current flex-shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span><strong>Note:</strong> These branding settings are saved but are not yet applied to the app, emails, PDFs, or favicon.</span>
        </div>
      </div>

      <div class="form-control mb-4">
        <label class="label cursor-pointer justify-start gap-3">
          <%= f.check_box :branding_enabled, class: 'checkbox checkbox-primary' %>
          <span class="label-text font-semibold">Enable Company Branding</span>
        </label>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :brand_name, 'Brand Name', class: 'label' %>
          <%= f.text_field :brand_name, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :brand_from_email_name, 'Brand From Email Name', class: 'label' %>
          <%= f.text_field :brand_from_email_name, class: 'base-input' %>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :brand_primary_color, 'Primary Color', class: 'label' %>
          <%= f.text_field :brand_primary_color, class: 'base-input', placeholder: '#1A73E8' %>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="form-control">
          <%= f.label :brand_logo_key, 'Logo Key', class: 'label' %>
          <%= f.text_field :brand_logo_key, class: 'base-input' %>
        </div>
        <div class="form-control">
          <%= f.label :brand_icon_key, 'Icon Key', class: 'label' %>
          <%= f.text_field :brand_icon_key, class: 'base-input' %>
        </div>
      </div>

      <div class="form-control pt-4">
        <%= f.button button_title(title: t('save'), disabled_with: t('saving')), class: 'base-button' %>
      </div>
    <% end %>
  </div>
  <div class="w-0 md:w-52"></div>
</div>
