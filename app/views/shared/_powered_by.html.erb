<div class="text-center px-2">
  <% if local_assigns[:with_counter] %>
    <% count = CompletedSubmitter.distinct.count(:submission_id) %>
    <% if count > 1 %>
      <%= t('count_documents_signed_with_html', count:) %>
    <% end %>
  <% end %>
  <a href="<%= root_url(Docuseal.default_url_options) %>" class="underline"><%= Docuseal.product_name %></a>
  &middot;
  <%= t('powered_by') %>
  <a href="<%= Docuseal::PRODUCT_URL %><%= local_assigns[:link_path] %>" class="underline" target="_blank" rel="noopener">DocuSeal</a>
  - <%= t('open_source_documents_software') %>
</div>
