<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0 md:space-x-10">
  <%= render 'shared/settings_nav' %>

  <div class="flex-grow min-w-0">
    <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-center mb-4">
      <h1 class="text-4xl font-bold">Recipient Directory</h1>

      <% if can?(:create, RecipientContact) %>
        <%= link_to new_settings_recipient_contact_path,
                    class: 'btn btn-primary btn-md gap-2 w-full md:w-fit',
                    data: { turbo_frame: 'modal' } do %>
          <%= svg_icon('plus', class: 'w-6 h-6') %>
          <span>New Recipient</span>
        <% end %>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="table w-full table-lg rounded-b-none overflow-hidden">
        <thead class="bg-base-200">
          <tr class="text-neutral uppercase">
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Visibility</th>
            <th class="text-right" width="1px"></th>
          </tr>
        </thead>

        <tbody>
          <% @recipient_contacts.each do |contact| %>
            <tr>
              <td><%= contact.name %></td>
              <td><%= contact.email %></td>
              <td><%= contact.phone %></td>
              <td>
                <% if contact.shared? %>
                  <span class="badge badge-info">Shared</span>
                <% else %>
                  <%= contact.company&.name %>
                <% end %>
              </td>
              <td class="flex items-center space-x-2 justify-end">
                <% if can?(:manage, contact) %>
                  <%= link_to 'Edit',
                              edit_settings_recipient_contact_path(contact),
                              class: 'btn btn-outline btn-xs',
                              data: { turbo_frame: 'modal' } %>

                  <%= button_to 'Delete',
                                settings_recipient_contact_path(contact),
                                method: :delete,
                                class: 'btn btn-outline btn-error btn-xs',
                                data: { turbo_confirm: 'Are you sure?' } %>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @recipient_contacts.blank? %>
            <tr>
              <td colspan="5" class="text-center opacity-70">
                No recipients yet.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
