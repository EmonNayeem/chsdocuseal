<%= render 'shared/turbo_modal', title: t('new_folder', default: 'New Folder') do %>
  <%= form_for @template_folder || TemplateFolder.new, url: folders_path, data: { turbo_frame: :_top }, html: { autocomplete: :off } do |f| %>
    <%= f.hidden_field :parent_folder_id, value: params[:parent_folder_id] %>
    <div class="form-control my-6">
      <%= f.text_field :name, required: true, placeholder: "#{t('folder_name', default: 'Folder name')}...", class: 'base-input w-full', autofocus: true, dir: 'auto' %>
    </div>

    <% if current_user.platform_admin? %>
      <div class="form-control mb-6">
        <%= f.collection_select :company_id, Company.order(:name), :id, :name, { selected: params[:company_id] || current_user.company_id }, { class: 'base-select w-full' } %>
      </div>
    <% end %>

    <div class="form-control">
      <%= f.button button_title(title: t('create', default: 'Create'), disabled_with: t('saving', default: 'Saving...')), class: 'base-button' %>
    </div>
  <% end %>
<% end %>
